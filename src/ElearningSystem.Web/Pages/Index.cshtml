@page
@using ElearningSystem.Web.Pages
@model IndexModel
@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="abp-page-container">
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h1 class="mb-0">Welcome, @Model.CurrentStudent.FirstName @Model.CurrentStudent.LastName</h1>
        </div>
        <div class="card-body">
            <p class="lead">Email: @Model.CurrentStudent.Email</p>
            <p>Enrolled since: @Model.CurrentStudent.EnrollmentDate.ToString("yyyy-MM-dd")</p>
        </div>
    </div>

    @if (Model.StudentCourses.Count == 0)
    {
        <div class="alert alert-info">
            <p>You are not enrolled in any courses yet.</p>
        </div>
    }
    else
    {
        @foreach (var course in Model.StudentCourses)
        {
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">@course.Name</h4>
                </div>
                <div class="card-body">
                    <p>@course.Description</p>

                    @if (Model.CourseExams.ContainsKey(course.Id) && Model.CourseExams[course.Id].Count > 0)
                    {
                        <h5>Available Exams</h5>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Exam Title</th>
                                        <th>Total Score</th>
                                        <th>Created Date</th>
                                        <th>Exam Results</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var examResults = Model.StudentExamResults[Model.CurrentStudent.Id];
                                    }

                                  @foreach (var exam in Model.CourseExams[course.Id])

        {
    
        var thisExamResults = examResults.Where(e => e.ExamId == exam.Id).ToList();
    
    <tr>
        <td>@exam.Title</td>
        <td>@exam.TotalScore</td>
        <td>@exam.CreatedDate.ToString("yyyy-MM-dd")</td>
        <td>
            @if (thisExamResults.Count > 0)
            {
                <div>
                    <strong>Exams Taken:</strong> @thisExamResults.Count<br />
                    <strong>Average Score:</strong> @thisExamResults.Average(e => e.Percentage).ToString("F2")%
                    <button type="button" class="btn btn-sm btn-info mt-1"
                            onclick="toggleExamResults('@exam.Id')">
                        <i class="fa fa-chevron-down" id="icon-@exam.Id"></i> View Details
                    </button>
                </div>
            }
            else
            {
                <span class="text-muted">No exams taken</span>
            }
        </td>
        <td>
            <a asp-page="/Exams/AttemptExam" asp-route-id="@exam.Id" class="btn btn-sm btn-primary">
                <i class="fa fa-play"></i> Attempt
            </a>
        </td>
    </tr>
    @if (thisExamResults.Count > 0)
    {
        <tr id="results-@exam.Id" style="display:none;" class="exam-results-row">
            <td colspan="5" style="background-color: #f8f9fa; padding: 20px;">
                <h6 class="mb-3">Exam Results for @Model.CurrentStudent.FirstName @Model.CurrentStudent.LastName</h6>
                <div class="row">
                    @foreach (var result in thisExamResults)
                    {
                        var passFail = result.Percentage >= 70 ? "success" : "danger";
                        var passFailText = result.Percentage >= 70 ? "Pass" : "Fail";

                        <div class="col-md-6 mb-3">
                            <div class="card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <h6 class="card-title mb-1">@exam.Title</h6>
                                            <p class="card-text mb-1">
                                                <strong>Score:</strong> @result.Score / @result.MaxScore
                                            </p>
                                            <p class="card-text mb-1">
                                                <strong>Percentage:</strong> @result.Percentage.ToString("F2")%
                                            </p>
                                            <p class="card-text mb-0">
                                                <strong>Date:</strong> @result.DateTaken.ToString("yyyy-MM-dd HH:mm")
                                            </p>
                                        </div>
                                        <span class="badge bg-@passFail">@passFailText</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="alert alert-info mt-2 mb-0">
                    <strong>Summary:</strong>
                    Total Exams: @thisExamResults.Count |
                    Average Score: @thisExamResults.Average(e => e.Percentage).ToString("F2")%
                </div>
            </td>
        </tr>
    }
}
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No exams available for this course yet.</p>
                    }
                </div>
            </div>
        }
    }
</div>
@section Scripts {
    <script>
        function toggleExamResults(studentId) {
            var resultsRow = document.getElementById('results-' + studentId);
            var icon = document.getElementById('icon-' + studentId);

            if (resultsRow.style.display === 'none') {
                // Show results
                resultsRow.style.display = 'table-row';
                icon.className = 'fa fa-chevron-up';
            } else {
                // Hide results
                resultsRow.style.display = 'none';
                icon.className = 'fa fa-chevron-down';
            }
        }

        // Delete confirmation
        document.addEventListener('DOMContentLoaded', function() {
            const deleteButtons = document.querySelectorAll('.delete-btn');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const form = this.closest('.delete-form');

                    abp.message.confirm(
                        'Are you sure you want to delete this student?',
                        'Confirm Delete',
                        function(granted) {
                            if (granted) {
                                form.submit();
                            }
                        }
                    );
                });
            });
        });
    </script>
}