@page
@using ElearningSystem.Web.Pages.Teacher
@model LecturesModel
@{
    ViewData["Title"] = "Lectures";
}

<div class="abp-page-container">

    <!-- Upload Card -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="fa fa-upload me-2"></i> Upload Lecture</h4>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Upload" enctype="multipart/form-data">
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Lecture Title *</label>
                            <input asp-for="LectureInput.Title" class="form-control" placeholder="e.g., Introduction to Algebra" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Course *</label>
                            <select asp-for="LectureInput.CourseId" class="form-select" required>
                                <option value="">-- Select a Course --</option>
                                @foreach (var course in Model.TeacherCourses)
                                {
                                    <option value="@course.Id">@course.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">File *</label>
                            <input asp-for="UploadedFile" type="file" class="form-control"
                                   accept=".pdf,.mp4,.avi,.mov,.mkv" />
                            <small class="text-muted">Allowed: PDF, MP4, AVI, MOV, MKV</small>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-upload me-1"></i> Upload
                </button>
            </form>
        </div>
    </div>

    <!-- Lectures List -->
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0"><i class="fa fa-list me-2"></i> Uploaded Lectures</h4>
        </div>
        <div class="card-body">
            @if (Model.Lectures.Count == 0)
            {
                <div class="alert alert-info text-center">
                    <p>No lectures uploaded yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Title</th>
                                <th>File Name</th>
                                <th>Type</th>
                                <th>Size</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lecture in Model.Lectures)
                            {
                                <tr>
                                    <td><strong>@lecture.Title</strong></td>
                                    <td>@lecture.FileName</td>
                                    <td>
                                        @if (lecture.FileType == "pdf")
                                        {
                                            <span class="badge bg-danger">PDF</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">Video</span>
                                        }
                                    </td>
                                    <td>@((lecture.FileSize / 1024.0 / 1024.0).ToString("F2")) MB</td>
                                    <td>
                                        <form method="post" asp-page-handler="Delete" style="display:inline;" class="delete-form">
                                            <input type="hidden" name="id" value="@lecture.Id" />
                                            <button type="button" class="btn btn-sm btn-danger delete-btn">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const deleteButtons = document.querySelectorAll('.delete-btn');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const form = this.closest('.delete-form');

                    abp.message.confirm(
                        'Are you sure you want to delete this lecture?',
                        'Confirm Delete',
                        function (granted) {
                            if (granted) {
                                form.submit();
                            }
                        }
                    );
                });
            });
        });
    </script>
}