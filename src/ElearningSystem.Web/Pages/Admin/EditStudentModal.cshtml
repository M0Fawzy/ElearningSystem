@page
@using ElearningSystem.Web.Pages.Admin
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model EditStudentModalModel
@{
	ViewData["Title"] = "Edit Students";
}

<div class="card mb-4">
    <div class="card-header">
        <h1>Manage Students</h1>
    </div>
    <div class="abp-page-container">
        <a asp-page="Students" class="btn btn-secondary mb-3">
            <i class="fa fa-arrow-left"></i> Back to Students
        </a>
    <div class="card-body">
        <form method="post" asp-page-handler="Update" >
            <input type="hidden" asp-for="StudentInput.Id" />
                <input type="hidden" asp-for="StudentInput.UserId" />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="StudentInput.FirstName" class="form-label">First Name *</label>
                        <input asp-for="StudentInput.FirstName" class="form-control" placeholder="First name" />
                        <span asp-validation-for="StudentInput.FirstName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="StudentInput.LastName" class="form-label">Last Name *</label>
                        <input asp-for="StudentInput.LastName" class="form-control" placeholder="Last name" />
                        <span asp-validation-for="StudentInput.LastName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="StudentInput.Email" class="form-label">Email *</label>
                        <input asp-for="StudentInput.Email" type="email" class="form-control" placeholder="student@example.com" />
                        <span asp-validation-for="StudentInput.Email" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="StudentInput.Password" class="form-label">Password *</label>
                    <input asp-for="StudentInput.Password" type="password" class="form-control" placeholder="Password (min 6 chars, 1 lowercase, 1 uppercase, 1 number)" />
                    <span asp-validation-for="StudentInput.Password" class="text-danger"></span>
                    <small class="text-muted d-block mt-2">
                        Password must contain:
                        <ul class="mb-0">
                            <li>At least 6 characters</li>
                            <li>At least one lowercase letter (a-z)</li>
                            <li>At least one uppercase letter (A-Z)</li>
                            <li>At least one number (0-9)</li>
                        </ul>
                    </small>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fa fa-plus"></i> Edit Student
            </button>
        </form>
    </div>
</div>
</div>
