@page
@using ElearningSystem.Web.Pages.Admin
@model CoursesModel
@{
    ViewData["Title"] = "Manage Courses";
}

<div class="abp-page-container">
    <div class="card mb-4">
        <div class="card-header">
            <h1>Manage Courses</h1>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Create">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="CourseInput.Name" class="form-label">Course Name *</label>
                            <input asp-for="CourseInput.Name" class="form-control" placeholder="e.g., Mathematics 101" />
                            <span asp-validation-for="CourseInput.Name" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CourseInput.Description" class="form-label">Description</label>
                    <textarea asp-for="CourseInput.Description" class="form-control" rows="3" placeholder="Course description..."></textarea>
                    <span asp-validation-for="CourseInput.Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Create Course
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Courses List</h5>
        </div>
        <div class="card-body">
            @if (Model.Courses.Count == 0)
            {
                <div class="alert alert-info">No courses created yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Created Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model.Courses)
                            {
                                <tr>
                                    <td>@course.Name</td>
                                    <td>@course.Description</td>
                                    <td>@course.CreatedDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                        <a asp-page="QuestionBank" asp-route-id="@course.Id" class="btn btn-sm btn-info">
                                            <i class="fa fa-pen"></i> Enter Question
                                        </a>

                                        <form method="post" asp-page-handler="Delete" asp-route-id="@course.Id" style="display: inline;" class="delete-form">
                                            <button type="button" class="btn btn-sm btn-danger delete-btn">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <!-- Showing X-Y of Z -->
                        <div>
                            Showing @((Model.CurrentPage - 1) * Model.PageSize + 1) -
                            @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount)
                            of @Model.TotalCount Courses
                        </div>

                        <!-- Pagination buttons -->
                        <nav>
                            <ul class="pagination">
                                <!-- Previous button -->
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-page="/Admin/Courses"
                                       asp-route-currentPage="@(Model.CurrentPage - 1)">
                                        Previous
                                    </a>
                                </li>

                                <!-- Page numbers -->
                                @for (int i = 1; i <= Math.Ceiling((double)Model.TotalCount / Model.PageSize); i++)
                                {
                                    <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                        <a class="page-link" asp-page="/Admin/Courses"
                                           asp-route-currentPage="@i">
                                            @i
                                        </a>
                                    </li>
                                }

                                <!-- Next button -->
                                <li class="page-item @(Model.CurrentPage >= Math.Ceiling((double)Model.TotalCount / Model.PageSize) ? "disabled" : "")">
                                    <a class="page-link" asp-page="/Admin/Courses"
                                       asp-route-currentPage="@(Model.CurrentPage + 1)">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Get all delete buttons
            const deleteButtons = document.querySelectorAll('.delete-btn');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const form = this.closest('.delete-form');

                    // Use ABP's notification service
                    abp.message.confirm(
                        'Are you sure you want to delete this?',
                        'Confirm Delete',
                        function(granted) {
                            if (granted) {
                                form.submit();  // Submit the form if confirmed
                            }
                        }
                    );
                });
            });
        });
    </script>
}