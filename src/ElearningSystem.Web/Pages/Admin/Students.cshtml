@page
@using ElearningSystem.Web.Pages.Admin
@model StudentsModel
@{
    ViewData["Title"] = "Manage Students";
}

<div class="abp-page-container">
    @if (ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong>
            @foreach (var modelState in ModelState.Values)
            {
                @foreach (var error in modelState.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h1>Manage Students</h1>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Create">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="StudentInput.FirstName" class="form-label">First Name *</label>
                            <input asp-for="StudentInput.FirstName" class="form-control" placeholder="First name" />
                            <span asp-validation-for="StudentInput.FirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="StudentInput.LastName" class="form-label">Last Name *</label>
                            <input asp-for="StudentInput.LastName" class="form-control" placeholder="Last name" />
                            <span asp-validation-for="StudentInput.LastName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="StudentInput.Email" class="form-label">Email *</label>
                            <input asp-for="StudentInput.Email" type="email" class="form-control" placeholder="student@example.com" />
                            <span asp-validation-for="StudentInput.Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="StudentInput.Password" class="form-label">Password *</label>
                            <input asp-for="StudentInput.Password" type="password" class="form-control" placeholder="Password (min 6 chars, 1 lowercase, 1 uppercase, 1 number)" />
                            <span asp-validation-for="StudentInput.Password" class="text-danger"></span>
                            <small class="text-muted d-block mt-2">
                                Password must contain:
                                <ul class="mb-0">
                                    <li>At least 6 characters</li>
                                    <li>At least one lowercase letter (a-z)</li>
                                    <li>At least one uppercase letter (A-Z)</li>
                                    <li>At least one number (0-9)</li>
                                </ul>
                            </small>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Create Student
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Students List</h5>
        </div>
        <div class="card-body">
            @if (Model.Students.Count == 0)
            {
                <div class="alert alert-info">No Students Created Yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Enrollment Date</th>
                                <th>Exam Results</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var student in Model.Students)
                            {
                                var examResults = Model.StudentExamResults[student.Id];
                                <tr>
                                    <td>@student.FirstName @student.LastName</td>
                                    <td>@student.Email</td>
                                    <td>@student.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        @if (examResults.Count > 0)
                                        {
                                            <div>
                                                <strong>Exams Taken:</strong> @examResults.Count<br />
                                                <strong>Average Score:</strong> @examResults.Average(e => e.Percentage).ToString("F2")%
                                                <br />
                                                <button type="button" class="btn btn-sm btn-info mt-1"
                                                        onclick="toggleExamResults('@student.Id')">
                                                    <i class="fa fa-chevron-down" id="icon-@student.Id"></i> View Details
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No exams taken</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-page="StudentCourses" asp-route-id="@student.Id" class="btn btn-sm btn-info">
                                            <i class="fa fa-book"></i> Enroll in Course
                                        </a>

                                        <a asp-page="EditStudentModal" asp-route-id="@student.Id" class="btn btn-sm btn-info">
                                            <i class="fa fa-pen"></i> Edit
                                        </a>

                                        <form method="post" asp-page-handler="Delete" asp-route-id="@student.Id" style="display: inline;" class="delete-form">
                                            <button type="button" class="btn btn-sm btn-danger delete-btn">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>

                                @* Expandable exam results row *@
                                @if (examResults.Count > 0)
                                {
                                    <tr id="results-@student.Id" style="display: none;" class="exam-results-row">
                                        <td colspan="5" style="background-color: #f8f9fa; padding: 20px;">
                                            <h6 class="mb-3">Exam Results for @student.FirstName @student.LastName</h6>
                                            <div class="row">
                                                @foreach (var result in examResults)
                                                {
                                                    var passFail = result.Percentage >= 70 ? "success" : "danger";
                                                    var passFailText = result.Percentage >= 70 ? "Pass" : "Fail";
                                                    var examTitle = Model.AllExams.ContainsKey(result.ExamId)
                                                    ? Model.AllExams[result.ExamId].Title
                                                    : "Unknown Exam";

                                                    <div class="col-md-6 mb-3">
                                                        <div class="card">
                                                            <div class="card-body">
                                                                <div class="d-flex justify-content-between align-items-start">
                                                                    <div>
                                                                        <h6 class="card-title mb-1">@examTitle</h6>
                                                                        <p class="card-text mb-1">
                                                                            <strong>Score:</strong> @result.Score / @result.MaxScore
                                                                        </p>
                                                                        <p class="card-text mb-1">
                                                                            <strong>Percentage:</strong> @result.Percentage.ToString("F2")%
                                                                        </p>
                                                                        <p class="card-text mb-0">
                                                                            <strong>Date:</strong> @result.DateTaken.ToString("yyyy-MM-dd HH:mm")
                                                                        </p>
                                                                    </div>
                                                                    <span class="badge bg-@passFail">@passFailText</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            <div class="alert alert-info mt-2 mb-0">
                                                <strong>Summary:</strong>
                                                Total Exams: @examResults.Count |
                                                Average Score: @examResults.Average(e => e.Percentage).ToString("F2")%
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleExamResults(studentId) {
            var resultsRow = document.getElementById('results-' + studentId);
            var icon = document.getElementById('icon-' + studentId);

            if (resultsRow.style.display === 'none') {
                // Show results
                resultsRow.style.display = 'table-row';
                icon.className = 'fa fa-chevron-up';
            } else {
                // Hide results
                resultsRow.style.display = 'none';
                icon.className = 'fa fa-chevron-down';
            }
        }

        // Delete confirmation
        document.addEventListener('DOMContentLoaded', function() {
            const deleteButtons = document.querySelectorAll('.delete-btn');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const form = this.closest('.delete-form');

                    abp.message.confirm(
                        'Are you sure you want to delete this student?',
                        'Confirm Delete',
                        function(granted) {
                            if (granted) {
                                form.submit();
                            }
                        }
                    );
                });
            });
        });
    </script>
}
