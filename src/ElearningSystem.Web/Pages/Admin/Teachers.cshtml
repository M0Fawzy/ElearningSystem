@page
@using ElearningSystem.Web.Pages.Admin
@model TeachersModel
@{
	ViewData["Title"] = "Manage Teachers";
}

<div class="abp-page-container">
    @if (ModelState.Values.SelectMany(v => v.Errors).Any())
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong>
            @foreach (var modelState in ModelState.Values)
            {
                @foreach (var error in modelState.Errors)
                {
                    <div>@error.ErrorMessage</div>
                }
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">
            <h1>Manage Teachers</h1>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Create">
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="TeacherInput.FirstName" class="form-label">First Name *</label>
                            <input asp-for="TeacherInput.FirstName" class="form-control" placeholder="First name" />
                            <span asp-validation-for="TeacherInput.FirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="TeacherInput.LastName" class="form-label">Last Name *</label>
                            <input asp-for="TeacherInput.LastName" class="form-control" placeholder="Last name" />
                            <span asp-validation-for="TeacherInput.LastName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="TeacherInput.Email" class="form-label">Email *</label>
                            <input asp-for="TeacherInput.Email" type="email" class="form-control" placeholder="teacher@example.com" />
                            <span asp-validation-for="TeacherInput.Email" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="TeacherInput.Password" class="form-label">Password *</label>
                            <input asp-for="TeacherInput.Password" type="password" class="form-control" placeholder="Password (min 6 chars, 1 lowercase, 1 uppercase, 1 number)" />
                            <span asp-validation-for="TeacherInput.Password" class="text-danger"></span>
                            <small class="text-muted d-block mt-2">
                                Password must contain:
                                <ul class="mb-0">
                                    <li>At least 6 characters</li>
                                    <li>At least one lowercase letter (a-z)</li>
                                    <li>At least one uppercase letter (A-Z)</li>
                                    <li>At least one number (0-9)</li>
                                </ul>
                            </small>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Create Teacher
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Teachers List</h5>
        </div>
        <div class="card-body">
            @if (Model.Teachers.Count == 0)
            {
                <div class="alert alert-info">No Teachers Created Yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Enrollment Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var teacher in Model.Teachers)
                            {
                                
                                <tr>
                                    <td>@teacher.FirstName @teacher.LastName</td>
                                    <td>@teacher.Email</td>
                                    <td>@teacher.EnrollmentDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a asp-page="TeacherCourses" asp-route-id="@teacher.Id" class="btn btn-sm btn-info">
                                            <i class="fa fa-book"></i> Enroll in Course
                                        </a>

                                        <a asp-page="EditTeacher" asp-route-id="@teacher.Id" class="btn btn-sm btn-info">
                                            <i class="fa fa-pen"></i> Edit
                                        </a>

                                        <form method="post" asp-page-handler="Delete" asp-route-id="@teacher.Id" style="display: inline;" class="delete-form">
                                            <button type="button" class="btn btn-sm btn-danger delete-btn">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Delete confirmation
        document.addEventListener('DOMContentLoaded', function() {
            const deleteButtons = document.querySelectorAll('.delete-btn');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const form = this.closest('.delete-form');

                    abp.message.confirm(
                        'Are you sure you want to delete this student?',
                        'Confirm Delete',
                        function(granted) {
                            if (granted) {
                                form.submit();
                            }
                        }
                    );
                });
            });
        });
    </script>
}

