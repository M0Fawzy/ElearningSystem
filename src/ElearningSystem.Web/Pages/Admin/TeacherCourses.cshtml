@page
@using ElearningSystem.Web.Pages.Admin
@model TeacherCoursesModel
@{
	ViewData["Title"] = "Teacher Courses";
}
<div class="abp-page-container">
    <a asp-page="Teachers" class="btn btn-secondary mb-3">
        <i class="fa fa-arrow-left"></i> Back to Teachers
    </a>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">@Model.CurrentTeacher.FirstName @Model.CurrentTeacher.LastName</h3>
        </div>
        <div class="card-body">
            <p><strong>Email:</strong> @Model.CurrentTeacher.Email</p>
            <p><strong>Enrollment Date:</strong> @Model.CurrentTeacher.EnrollmentDate.ToString("yyyy-MM-dd")</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Enroll in Course</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Enroll">
                <input type="hidden" asp-for="EnrollInput.TeacherId" />

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="EnrollInput.CourseId" class="form-label">Select Course *</label>
                            <select asp-for="EnrollInput.CourseId" class="form-select">
                                <option value="">-- Select a Course --</option>
                                @foreach (var course in Model.AllCourses)
                                {
                                    var isEnrolled = Model.EnrolledCourses.Any(c => c.Id == course.Id);
                                    if (!isEnrolled)
                                    {
                                        <option value="@course.Id">@course.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="EnrollInput.CourseId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="fa fa-plus"></i> Enroll
                </button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Enrolled Courses</h5>
        </div>
        <div class="card-body">
            @if (Model.EnrolledCourses.Count == 0)
            {
                <div class="alert alert-info">Teacher is not enrolled in any courses yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Course Name</th>
                                <th>Description</th>
                                <th>Created Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model.EnrolledCourses)
                            {
                                <tr>
                                    <td>@course.Name</td>
                                    <td>@course.Description</td>
                                    <td>@course.CreatedDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <form method="post" asp-page-handler="Unenroll" style="display: inline;" class="delete-form">
                                            <input type="hidden" name="teacherId" value="@Model.CurrentTeacher.Id" />
                                            <input type="hidden" name="courseId" value="@course.Id" />
                                            <button type="submit" class="btn btn-sm btn-danger delete-btn">
                                                <i class="fa fa-trash"></i> Unenroll
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Delete confirmation
        document.addEventListener('DOMContentLoaded', function() {
            const deleteButtons = document.querySelectorAll('.delete-btn');

            deleteButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const form = this.closest('.delete-form');

                    abp.message.confirm(
                        'Are you sure you want to delete this student?',
                        'Confirm Delete',
                        function(granted) {
                            if (granted) {
                                form.submit();
                            }
                        }
                    );
                });
            });
        });
    </script>
}