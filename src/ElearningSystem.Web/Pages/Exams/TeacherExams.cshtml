@page
@using ElearningSystem.Web.Pages.Exams
@model TeacherExamsModel
@{
    ViewData["Title"] = "My Exams";
}

<div class="abp-page-container">
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                <h1>My Exams</h1>
            </div>
            <div class="card-toolbar">
                <a asp-page="/Exams/CreateExam" class="btn btn-primary">
                    <i class="fa fa-plus"></i>
                    <span>Create New Exam</span>
                </a>
            </div>
        </div>

        <div class="card-body">
            @if (Model.TeacherExams.Count == 0)
            {
                <div class="alert alert-info text-center">
                    <p>No exams yet. Create one to get started!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-dark">
                            <tr>
                                <th>Title</th>
                                <th>Course</th>
                                <th>Duration</th>
                                <th>Created Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exam in Model.TeacherExams)
                            {
                                <tr>
                                    <td><strong>@exam.Title</strong></td>
                                    <td>
                                        @{
                                            var courseName = Model.TeacherCourses.FirstOrDefault(c => c.Id == exam.CourseId)?.Name ?? "Unknown";
                                        }
                                        @courseName
                                    </td>
                                    <td>@exam.DurationMinutes min</td>
                                    <td>@exam.CreatedDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button type="button"
                                                    class="btn btn-sm btn-info manage-questions-btn"
                                                    data-exam-id="@exam.Id"
                                                    data-exam-title="@exam.Title">
                                                <i class="fa fa-pen"></i> Manage Questions
                                            </button>

                                            <a asp-page="/Exams/EditQuestion" asp-route-id="@exam.Id" class="btn btn-sm btn-warning">
                                                <i class="fa fa-pen"></i> Edit
                                            </a>

                                            <button type="button" class="btn btn-sm btn-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    onclick="setDeleteId('@exam.Id')">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Manage Questions Modal -->
<div class="modal fade" id="manageQuestionsModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalExamTitle">Manage Questions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="loadingSpinner" class="text-center" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p>Loading questions...</p>
                </div>

                <div id="questionsInExamSection">
                    <h6>Questions in Exam (<span id="examQuestionsCount">0</span>)</h6>
                    <div id="examQuestionsList" class="list-group mb-3"></div>
                    <div id="noQuestionsMessage" style="display: none;">
                        <p class="text-muted">No questions yet. Add some below!</p>
                    </div>
                </div>

                <hr>

                <div id="availableQuestionsSection">
                    <h6>Add Questions (<span id="availableQuestionsCount">0</span>)</h6>
                    <div id="availableQuestionsList" class="list-group"></div>
                    <div id="noAvailableMessage" style="display: none;">
                        <p class="text-muted">All questions are already in the exam!</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this exam?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" id="deleteForm" style="display:inline;">
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setDeleteId(id) {
            document.getElementById('deleteId').value = id;
        }

        let currentExamId = null;

        document.addEventListener('DOMContentLoaded', function () {
            const manageButtons = document.querySelectorAll('.manage-questions-btn');

            manageButtons.forEach(button => {
                button.addEventListener('click', function () {
                    currentExamId = this.dataset.examId;
                    const examTitle = this.dataset.examTitle;

                    document.getElementById('modalExamTitle').textContent = `Manage Questions: ${examTitle}`;
                    document.getElementById('loadingSpinner').style.display = 'block';
                    document.getElementById('questionsInExamSection').style.display = 'none';
                    document.getElementById('availableQuestionsSection').style.display = 'none';

                    const modal = new bootstrap.Modal(document.getElementById('manageQuestionsModal'));
                    modal.show();

                    loadQuestions(currentExamId);
                });
            });
        });

        function loadQuestions(examId) {
            fetch(`/Exams/Exam?handler=LoadQuestions&id=${examId}`)
                .then(response => response.json())
                .then(data => {
                    document.getElementById('loadingSpinner').style.display = 'none';
                    document.getElementById('questionsInExamSection').style.display = 'block';
                    document.getElementById('availableQuestionsSection').style.display = 'block';
                    displayQuestionsInExam(data.questionsInExam);
                    displayAvailableQuestions(data.availableQuestions);
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error loading questions. Please try again.');
                });
        }

        function displayQuestionsInExam(questions) {
            const container = document.getElementById('examQuestionsList');
            const countSpan = document.getElementById('examQuestionsCount');
            const noQuestionsMsg = document.getElementById('noQuestionsMessage');

            container.innerHTML = '';
            countSpan.textContent = questions.length;

            if (questions.length === 0) {
                noQuestionsMsg.style.display = 'block';
                container.style.display = 'none';
                return;
            }

            noQuestionsMsg.style.display = 'none';
            container.style.display = 'block';

            questions.forEach((question, index) => {
                const div = document.createElement('div');
                div.className = 'list-group-item';
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h6 class="mb-1">${index + 1}. ${question.questionText}</h6>
                            <small class="text-muted">Type: ${question.questionType} | Score: ${question.score}</small>
                        </div>
                        <button class="btn btn-sm btn-danger remove-question-btn" data-question-id="${question.id}">
                            <i class="fa fa-trash"></i> Remove
                        </button>
                    </div>`;
                container.appendChild(div);
            });

            attachRemoveListeners();
        }

        function displayAvailableQuestions(questions) {
            const container = document.getElementById('availableQuestionsList');
            const countSpan = document.getElementById('availableQuestionsCount');
            const noAvailableMsg = document.getElementById('noAvailableMessage');

            container.innerHTML = '';
            countSpan.textContent = questions.length;

            if (questions.length === 0) {
                noAvailableMsg.style.display = 'block';
                container.style.display = 'none';
                return;
            }

            noAvailableMsg.style.display = 'none';
            container.style.display = 'block';

            questions.forEach(question => {
                const div = document.createElement('div');
                div.className = 'list-group-item';
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <h6 class="mb-1">${question.questionText}</h6>
                            <small class="text-muted">Type: ${question.questionType} | Score: ${question.score}</small>
                        </div>
                        <button class="btn btn-sm btn-success add-question-btn" data-question-id="${question.id}">
                            <i class="fa fa-plus"></i> Add
                        </button>
                    </div>`;
                container.appendChild(div);
            });

            attachAddListeners();
        }

        function attachAddListeners() {
            document.querySelectorAll('.add-question-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const questionId = this.dataset.questionId;
                    this.disabled = true;

                    fetch(`/Exams/Exam?handler=AddQuestions&id=${currentExamId}&questionId=${questionId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(r => r.json())
                    .then(data => {
                        if (data.success) loadQuestions(currentExamId);
                        else { alert(data.message); this.disabled = false; }
                    });
                });
            });
        }

        function attachRemoveListeners() {
            document.querySelectorAll('.remove-question-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const questionId = this.dataset.questionId;

                    abp.message.confirm('Remove this question from the exam?', 'Confirm Removal', function (confirmed) {
                        if (confirmed) {
                            button.disabled = true;

                            fetch(`/Exams/Exam?handler=RemoveQuestions&id=${currentExamId}&questionId=${questionId}`, {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                                }
                            })
                            .then(r => r.json())
                            .then(data => {
                                if (data.success) { abp.notify.success(data.message); loadQuestions(currentExamId); }
                                else { abp.notify.error(data.message); button.disabled = false; }
                            });
                        }
                    });
                });
            });
        }
    </script>
}